# MONN Game Language · نسخه ۲
# یک نمونهٔ قابل اجرا؛ فایل‌های رسانه را در پوشه assets قرار بده.
بازی "ماجرای دروازه"
شناسه "gate-adventure"
شروع "gate"
پایان = "yard"
پدیدآورنده = "سازندهٔ بازی"
مجوز = "MIT"

بازیکن {
  جان = 100
  حداکثر_جان = 100
  ویژگی "سکه" = 0
  کوله_پشتی = []
}

شخصیت "guard" {
  نام = "نگهبان"
  ویدیو = "assets/guard.mp4"
  حالت "خوشحال" = "assets/guard-happy.mp4"
  حالت "عصبانی" = "assets/guard-angry.mp4"
  هوش_مصنوعی = true
  مدل_هوش = "gpt-4o-mini"
  دستور = "تو نگهبان یک دروازهٔ باستانی هستی. کوتاه، مرموز و در نقش خودت پاسخ بده."
  قانون_پاسخ "سلام" => "درود، مسافر. به دروازهٔ شمالی رسیده‌ای."
  قانون_پاسخ "کلید" => "کلید در حیاط پشتی پنهان شده است."
}

مأموریت "find-key" "پیدا کردن کلید" {
}

صحنه "gate" "دروازهٔ شمالی" {
  روایت = "نگهبانی در مقابل دروازه ایستاده است. او راه را بسته و منتظر پاسخ توست."
  تصویر = "assets/gate.webp"
  موسیقی = "assets/ambient.ogg"
  دیالوگ = {"character":"guard","text":"ایست! برای ورود باید کلید را پیدا کنی.","expression":"خوشحال"}
  انتخاب "پرسیدن دربارهٔ کلید" -> "yard" {
    شناسه = "ask-key"
    شرط "stat" "سکه" >= 0
    اثر مأموریت "find-key" start
    اثر "stat" "سکه" add 1
    صدا = "assets/click.ogg"
  }
}

صحنه "yard" "حیاط پشتی" {
  روایت = "در حیاط، یک صندوق قدیمی دیده می‌شود. اینجا می‌توانی داستان را ادامه بدهی."
  تصویر = "assets/yard.webp"
}

جهان {
  فعال = true
  عرض = 800
  ارتفاع = 450
  بازیکن_جهان {
    x = 40
    y = 40
    width = 32
    height = 44
    speed = 3
    color = "#42d7e8"
    frames = 4
    fps = 8
    frame_width = 32
    frame_height = 44
  }
  شیء "stone-wall" {
    x = 250
    y = 80
    width = 90
    height = 180
    color = "#65758b"
    solid = true
  }
}

رابط {
  منو_فعال = true
  عنوان_منو = "ماجرای دروازه"
  برچسب_شروع = "ورود به ماجرا"
  برچسب_تنظیمات = "تنظیمات"
  نمایش_جان = true
  نمایش_کوله = true
  نمایش_مأموریت = true
  عنصر_رابط = {"type":"name_input","text":"نام ماجراجو","x":10,"y":15,"width":80}
}
